// APBC 1D Hubbard, L=8, t=1, U=2, half filling (Ne=8, Ne_per_spin=4).
// Fills the two lowest (k, -k) shells at k = +/- pi/8 and +/- 3pi/8.
// Closed shell at the free-particle level; mVMC's Pfaffian
// reconstruction matches H-wave UHF within ~0.4% rel.
//
// Use this as the working APBC reference. case_apbc (Ne=4 single
// shell) is documented as a known mVMC corner case.
L     = 8
Lsub  = 8
model = "FermionHubbard"
lattice = "chain"
t     = 1.0
U     = 2.0
phase0 = 180.0
ncond = 8
2Sz   = 0
NSPGaussLeg    = 1
NVMCCalMode    = 1
NLanczosMode   = 0
NDataIdxStart  = 1
NDataQtySmp    = 1
NSROptItrStep  = 0
// NSROptItrSmp is not used when NSROptItrStep = 0; vmcdry hangs on the
// warning emitted for the unused key, so we omit it.
NVMCWarmUp     = 10
NVMCInterval   = 1
NVMCSample     = 4000
RndSeed        = 12345
NSplitSize     = 1
NStore         = 0
