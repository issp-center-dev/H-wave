// APBC 1D Hubbard L=8, t=1, U=2, Ncond=4 with sublattice grouping.
// Lsub=2 tells StdFace to impose the 2-site sublattice translation
// symmetry on orbitalidx.def (matching the SubShape=[2,1,1] fold on
// the H-wave side).
L     = 8
Lsub  = 2
model = "FermionHubbard"
lattice = "chain"
t     = 1.0
U     = 2.0
phase0 = 180.0
ncond = 4
2Sz   = 0
NSPGaussLeg    = 1
NVMCCalMode    = 1
NLanczosMode   = 0
NDataIdxStart  = 1
NDataQtySmp    = 1
NSROptItrStep  = 0
NVMCWarmUp     = 10
NVMCInterval   = 1
NVMCSample     = 10000
RndSeed        = 12345
NSplitSize     = 1
NStore         = 0
